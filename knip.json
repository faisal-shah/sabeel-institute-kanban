{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "app": {
      "entry": [
        "index.ts",
        "App.tsx",
        "**/*.web.ts",
        "**/*.web.tsx",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.{ts,tsx}"
      ]
    },
    "functions": {
      "entry": [
        "src/index.ts",
        "test/**/*.test.ts"
      ],
      "project": "src/**/*.ts"
    },
    "packages/shared": {
      "entry": [
        "src/index.ts"
      ],
      "project": "src/**/*.ts"
    },
    ".": {
      "entry": [
        "scripts/*.mjs"
      ],
      "project": [
        "scripts/**/*.mjs"
      ]
    }
  },
  "ignoreDependencies": [
    "@sentry/react",
    "@sabeel/shared"
  ],
  "ignoreBinaries": [
    "firebase",
    "expo"
  ]
}
