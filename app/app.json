{
  "expo": {
    "name": "Sabeel Kanban",
    "slug": "sabeel-institute-kanban",
    "version": "0.7.7",
    "orientation": "portrait",
    "scheme": "sabeelkanban",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "bundleIdentifier": "com.sabeelinstitute.kanban",
      "buildNumber": "1",
      "supportsTablet": false,
      "googleServicesFile": "./GoogleService-Info.plist",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sabeelinstitute.kanban",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F6EBDD"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Sabeel Kanban uses your photos so you can attach one to a card.",
          "cameraPermission": "Sabeel Kanban uses the camera so you can attach a photo to a card."
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-build-properties",
        {
          "ios": {
            "extraPods": [
              {
                "name": "GoogleUtilities",
                "modular_headers": true
              },
              {
                "name": "RecaptchaInterop",
                "modular_headers": true
              }
            ]
          }
        }
      ],
      "@sentry/react-native/expo"
    ]
  }
}
