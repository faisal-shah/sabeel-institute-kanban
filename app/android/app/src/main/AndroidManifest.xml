<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Only what the app actually uses: INTERNET (Firebase) and VIBRATE
       (notification buzz). No overlay permissions — there is no draw-over-apps
       feature. These were Expo scaffold defaults; a future `expo prebuild`
       would re-add them, so they must be suppressed in app.json if this native
       project is ever regenerated (android/ is committed, not regenerated now). -->
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.VIBRATE"/>

  <!-- WRITE_EXTERNAL_STORAGE is removed. expo-file-system and expo-image-picker
       both declare it (capped at API 32) and the merger would fold it in, but
       nothing here writes outside this app's own cache directory, which has
       never needed a permission. Asking to write files nobody else can see is
       the kind of permission that makes people refuse an install.

       READ_EXTERNAL_STORAGE is deliberately LEFT ALONE. expo-image-picker
       declares it "required for picking images from camera roll" on API <= 32,
       and minSdkVersion here is 24, so devices in that range are in scope. The
       AVD is API 35 and takes the modern photo-picker path, so this project
       cannot verify the old one either way — and silently overriding a
       library's own statement of what it needs, on a path nobody can test, is
       how a feature comes to be broken only for the person on the oldest
       phone. It is capped at 32, so it is inert on Android 13 and later. -->
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove"/>

  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
    <!-- Opening an attachment in whatever app claims its type.
         On API 30+ package visibility hides every handler unless it is declared
         here, and the failure is silent: startActivityAsync resolves to nothing
         and the tap simply does nothing at all. expo-intent-launcher ships an
         empty manifest, so this cannot come from the library. -->
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <data android:mimeType="*/*"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false">
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="sabeelkanban"/>
      </intent-filter>
    </activity>
  </application>
</manifest>