<?xml version="1.0" encoding="utf-8"?>
<!--
  The status-bar / shade icon for a push.

  Android draws a small icon from its ALPHA CHANNEL ONLY: every opaque pixel is
  painted flat in the tint colour and everything else is dropped. Configure
  nothing and the default is the launcher icon, which is a full-bleed square —
  its silhouette carries no mark at all, so it renders as a featureless blob.

  So this is a silhouette by construction: transparent ground, one opaque glyph.
  The glyph is the three-column board from the app icon's badge, which is the
  part of the mark that still reads at 24dp — the Arabic wordmark does not.

  A vector rather than five PNGs: it stays crisp at every density, and it is the
  only form of this asset that is reviewable in a diff.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

  <!-- Three columns, tops aligned, descending — a board with work draining right. -->
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M5.0,4 H6.4 A1.6,1.6 0 0 1 8.0,5.6 V18.4 A1.6,1.6 0 0 1 6.4,20 H5.0 A1.6,1.6 0 0 1 3.4,18.4 V5.6 A1.6,1.6 0 0 1 5.0,4 Z" />
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M11.3,4 H12.7 A1.6,1.6 0 0 1 14.3,5.6 V13.9 A1.6,1.6 0 0 1 12.7,15.5 H11.3 A1.6,1.6 0 0 1 9.7,13.9 V5.6 A1.6,1.6 0 0 1 11.3,4 Z" />
  <path
      android:fillColor="#FFFFFFFF"
      android:pathData="M17.6,4 H19.0 A1.6,1.6 0 0 1 20.6,5.6 V9.6 A1.6,1.6 0 0 1 19.0,11.2 H17.6 A1.6,1.6 0 0 1 16.0,9.6 V5.6 A1.6,1.6 0 0 1 17.6,4 Z" />
</vector>
